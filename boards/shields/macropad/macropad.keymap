#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        screenshot_clip: screenshot_clip {
            compatible = "zmk,behavior-macro";
            label = "Screenshot to Clipboard";
            #binding-cells = <0>;
            bindings = <
                &kp LG(LS(LC(N4)))    /* cmd + shift + ctrl + 4 */
            >;
        };

        cmd_q_macro: cmd_q {
            compatible = "zmk,behavior-macro";
            label = "Cmd+Q";
            #binding-cells = <0>;
            bindings = <
                &kp LG(Q) /* cmd + q*/
            >;
        };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&trans>, <&cmd_q_macro>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------
            // | R1    |                 | R2     |
            // ------------------------------------
            // | KEY 1 | KEY 2  | KEY 3  | KEY 4  |
            // | KEY 5 | KEY 6  | KEY 7  | KEY 8  |
            // | KEY 9 | KEY 10 | KEY 11 | KEY 12 |
            // ------------------------------------
            bindings = <
                /*         D10          D16             D14                     D15                 D19         D4  */
                /* D7 */  &td0          &kp C_PREV      &kp C_PLAY_PAUSE        &kp C_NEXT          &trans      &trans
                /* D8 */  &kp E         &kp F           &kp G                   &kp H               &trans      &trans
                /* D9 */  &kp LG(C)     &kp LG(V)       &screenshot_clip        &kp LC(LG(Q))       &trans      &trans

                /* Encoder left - D18:D19 */
                /* D18 */ &trans        &trans          &trans                  &trans              &bt BT_CLR  &trans

                /* Encoder right - D4:D5 */
                /* D5 */  &trans        &trans          &trans                  &trans              &trans      &kp C_MUTE
            >;
//        // Copy (⌘ + C)
    //         // Paste (⌘ + V)
    //     // Lock Screen (⌃ + ⌘ + Q)

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;


            
        };
    };

    combos {
        compatible = "zmk,combos";

        // W + R => Clear all Bluetooth pairings
        bt_clear_combo {
            timeout-ms = <50>;                 // Time window to press both keys
            key-positions = <28 35>;           // Positions of W and R in your keymap
            bindings = <&kp A>;                // Trigger Bluetooth clear
        };
    };
};
