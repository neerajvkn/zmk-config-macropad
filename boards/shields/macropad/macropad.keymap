#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------
            // | ROTARY (VOL+/VOL-, PLAY/PAUSE) |   Reset          |
            // |         PREV                   |   NEXT           |
            // -----------------------------------------------------
            bindings = <
                &kp A           &kp B       &kp C       &kp D
                &kp E           &kp F       &kp G       &kp H
                &kp I           &kp J       &kp K       &kp L
            >;

            // rotary encoder up and down
            sensor-bindings = <&inc_dec_kp C_FAST_FORWARD C_REWIND>;
            //Rotaty encoder button press
            button-bindings = <&kp C_PP>;
        };
    };
};
