#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------
            // | ROTARY (VOL+/VOL-, PLAY/PAUSE) |   Reset          |
            // |         PREV                   |   NEXT           |
            // -----------------------------------------------------
            bindings = <
                /* Row 0 */ &kp A    &kp B    &kp C    &kp D    &kp M    &kp N
                /* Row 1 */ &kp E    &kp F    &kp G    &kp H    &kp O    &kp P
                /* Row 2 */ &kp I    &kp J    &kp K    &kp L    &kp Q    &kp R

                /* Row 3 → Left Encoder Btn: D18 + D19 */
                &kp S    &kp T    &kp U    &kp V    &kp W  &kp X

                /* Row 4 → Right Encoder Btn: D20 + D21 */
                &kp Y    &kp Z    &kp 1    &kp 2    &kp 3   &kp 4
            >;

            // rotary encoder up and down
            // sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DOWN>>;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN>;
        };
    };
};