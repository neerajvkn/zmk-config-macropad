#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------
            // | ROTARY (VOL+/VOL-, PLAY/PAUSE) |   Reset          |
            // |         PREV                   |   NEXT           |
            // -----------------------------------------------------
            bindings = <
                /* Row 0 */ &kp A    &kp B    &kp C    &kp D    &trans    &trans
                /* Row 1 */ &kp E    &kp F    &kp G    &kp H    &trans    &trans
                /* Row 2 */ &kp I    &kp J    &kp K    &kp L    &trans    &trans

                /* Row 3 → Left Encoder Btn: D18 + D19 */
                &trans    &trans    &trans    &trans    &trans  &kp M

                /* Row 4 → Right Encoder Btn: D20 + D21 */
                &trans    &trans    &trans    &trans    &kp N   &trans
            >;

            // rotary encoder up and down
            // sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DOWN>>;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};



