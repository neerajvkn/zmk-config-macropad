#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        screenshot_clip: screenshot_clip {
            compatible = "zmk,behavior-macro";
            label = "Screenshot to Clipboard";
            #binding-cells = <0>;
            bindings = <
                &kp LG(LS(LC(N4)))    /* cmd + shift + ctrl + 4 */
            >;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------
            // | ROTARY (VOL+/VOL-, PLAY/PAUSE) |   Reset          |
            // |         PREV                   |   NEXT           |
            // -----------------------------------------------------
            bindings = <
                      /* D10         D16      D14        D15       D19       D21  */
                /* D7 */  &screenshot_clip     &kp B     &kp C     &kp D     &trans    &trans
                /* D8 */  &kp E     &kp F     &kp G     &kp H     &trans    &trans
                /* D9 */  &kp I     &kp J     &kp K     &kp L     &trans    &trans

                /* Encoder left - D18:D19 */
                /* D18 */ &trans    &trans    &trans    &trans    &kp W     &trans

                /* Encoder right - D*/
                /* D20 */ &trans    &trans    &trans    &trans    &trans     &kp R
            >;

            // rotary encoder up and down
            // sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DOWN>>;
            sensor-bindings = <&inc_dec_kp C_VOL_DN C_VOL_UP &inc_dec_kp PG_UP PG_DN>;
        };
    };
};