#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        screenshot_clip: screenshot_clip {
            compatible = "zmk,behavior-macro";
            label = "Screenshot to Clipboard";
            #binding-cells = <0>;
            bindings = <
                &kp LG(LS(LC(N4)))    /* cmd + shift + ctrl + 4 */
            >;
        };

        // cmd_q_macro: cmd_q_macro {
        //     compatible = "zmk,behavior-macro";
        //     label = "Cmd+Q";
        //     #binding-cells = <0>;
        //     bindings = <
        //         &kp LG(LS(LC(N4)))      /* cmd + shift + ctrl + 4 */
        //     >;
        // };

        // td_cmd_q: td_cmd_q {
        //     compatible = "zmk,behavior-tap-dance";
        //     label = "Double-tap for Cmd+Q";
        //     #binding-cells = <0>;
        //     bindings = <&trans>, <&cmd_q_macro>;
        //     // tap-count = <2>;
        // };
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp N1>, <&kp N2>, <&kp N3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------
            // | ROTARY (VOL+/VOL-, PLAY/PAUSE) |   Reset          |
            // |         PREV                   |   NEXT           |
            // -----------------------------------------------------
            bindings = <
                /*              D10              D16       D14       D15              D19      D21  */
                /* D7 */  &screenshot_clip      &td0     &kp C     &kp D           &trans    &trans
                /* D8 */  &kp E                 &kp F     &kp G     &kp H           &trans    &trans
                /* D9 */  &kp I                 &kp J     &kp K     &bt BT_CLR           &trans    &trans

                /* Encoder left - D18:D19 */
                /* D18 */ &kp 1                &kp 3    &kp 5    &kp 7           &kp W     &kp X

                /* Encoder right - D*/
                /* D20 */ &kp 2                &kp 4    &kp 6    &kp 8           &kp Y     &kp C_MUTE
            >;

            // rotary encoder up and down
            // sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DOWN>>;
            // sensor-bindings = <&inc_dec_kp PG_UP PG_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp C_VOL_UP C_VOL_DN>;


            
        };
    };

    combos {
        compatible = "zmk,combos";

        // W + R => Clear all Bluetooth pairings
        bt_clear_combo {
            timeout-ms = <50>;                 // Time window to press both keys
            key-positions = <28 35>;           // Positions of W and R in your keymap
            bindings = <&kp A>;                // Trigger Bluetooth clear
        };
    };
};
