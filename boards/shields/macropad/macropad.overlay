#include <dt-bindings/zmk/matrix_transform.h>

#include <layouts/common/ortho_4x12/all1u.dtsi>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &layout_ortho_4x12_all1u;
    };

    matrix_transform_40_all1u: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <6>;   /* 4 normal + 2 for encoder btns */
        rows = <5>;      /* 3 normal + 2 encoder button rows */
        map = <
            /* Row 0 */ RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)
            /* Row 1 */ RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)
            /* Row 2 */ RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5)
            /* Row 3 */ RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5)
            /* Row 4 */ RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5)
        >;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;
        diode-direction = "col2row";

        /* ----- 6 COLUMNS (4 normal + 2 extra for encoder buttons) ----- */
        col-gpios = 
            <&pro_micro 10 GPIO_ACTIVE_HIGH>,  /* C0 -> D10 */
            <&pro_micro 16 GPIO_ACTIVE_HIGH>,  /* C1 -> D16 */
            <&pro_micro 14 GPIO_ACTIVE_HIGH>,  /* C2 -> D14 */
            <&pro_micro 15 GPIO_ACTIVE_HIGH>,  /* C3 -> D15 */
            <&pro_micro 19 GPIO_ACTIVE_HIGH>,  /* C4 -> Left Encoder Btn second pin */
            <&pro_micro 5 GPIO_ACTIVE_HIGH>;  /* C5 -> Right Encoder Btn second pin */

        /* ----- 5 ROWS (3 normal + 2 encoder buttons) ----- */
        row-gpios =
            <&pro_micro 7  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,  /* R0 -> D7 */
            <&pro_micro 8  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,  /* R1 -> D8 */
            <&pro_micro 9  (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,  /* R2 -> D9 */
            <&pro_micro 18 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>,  /* R3 -> Left Encoder Btn first pin */
            <&pro_micro 4 (GPIO_ACTIVE_HIGH | GPIO_PULL_DOWN)>;  /* R4 -> Right Encoder Btn first pin */
    };


    left_encoder: encoder_left {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 20 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 21 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        status = "okay";
    };

    right_encoder: encoder_right {
        compatible = "alps,ec11";
        a-gpios = <&pro_micro 1 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        b-gpios = <&pro_micro 0 (GPIO_ACTIVE_HIGH | GPIO_PULL_UP)>;
        steps = <80>;
        status = "okay";
    };

    sensors: sensors {
        compatible = "zmk,keymap-sensors";
        sensors = <&left_encoder &right_encoder>;
        triggers-per-rotation = <20>;
    };
};

&layout_ortho_4x12_all1u {
    transform = <&matrix_transform_40_all1u>;
};